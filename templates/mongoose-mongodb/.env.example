# ===========================================
# Mongoose + MongoDB Environment Template
# Copy this file to .env and adjust the values
# ===========================================

# Application
NODE_ENV=development
PORT=3000

# MongoDB connection string
# Local (docker compose mongo service with root user):
MONGODB_URL=mongodb://admin:password@localhost:27017/mongoose_db?authSource=admin
# Optional: override the database name from the URL
# MONGODB_DB_NAME=mongoose_db
# Connection pool size
MONGODB_MAX_POOL_SIZE=10

# Docker Compose (mongo service)
COMPOSE_PROJECT_NAME=mongoose-mongodb
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password
MONGO_DATABASE=mongoose_db

# JWT Authentication (change in production!)
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h

# Logging
LOG_FORMAT=dev
LOG_DIR=logs
LOG_LEVEL=info

# CORS
ORIGIN=http://localhost:3000
CREDENTIALS=true
# Comma separated whitelist, e.g. http://localhost:3000,http://localhost:5173
# CORS_ORIGINS=http://localhost:3000
