{
  "name": "mongoose-mongodb",
  "version": "1.0.0",
  "description": "Mongoose ODM with MongoDB template",
  "scripts": {
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "dev": "cross-env NODE_ENV=development nodemon",
    "build": "tsc && tsc-alias",
    "check": "tsc --noEmit",
    "db:seed": "tsx src/config/seed.ts",
    "db:reset": "tsx src/config/reset.ts",
    "db:indexes": "tsx src/config/sync-indexes.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.0",
    "morgan": "^1.12.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.1",
    "cross-env": "^10.1.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
